// Portable Zellij config for native Linux + WSL.
// Docs: setup/docs/zellij.md

on_force_close "detach"

// Omit default_shell so Zellij uses $SHELL (bash on WSL, fish on native, etc.).
default_layout "compact"

// No powerline / nerd-font arrow separators in built-in UI
simplified_ui true

// Catppuccin Mocha + muted pane borders (see themes/catppuccin-mocha-muted.kdl)
theme "catppuccin-mocha-muted"

// Start Locked so Ctrl-p/t/o/n/s/h don't steal from Neovim (Telescope, blink, jumplist…).
// Unlock with Ctrl-g when you need full Pane/Tab/Session modes.
default_mode "locked"

pane_frames true
auto_layout true
// 关闭 stacked resize：Alt +/- 只调整大小，不再把相邻 pane 叠起，也不会把已叠起的 pane 拆开
stacked_resize false
mouse_mode true
copy_on_select true
// Portable clipboard helper: setup/.config/shell/clipcopy → ~/.local/bin/clipcopy
copy_command "clipcopy"
scroll_buffer_size 100000
styled_underlines true
show_startup_tips false
show_release_notes false

session_serialization true
pane_viewport_serialization true
scrollback_lines_to_serialize 1000

keybinds {
    // Free Ctrl-b for Neovim (cmp doc scroll, etc.) — disable Zellij "tmux mode"
    shared_except "tmux" "locked" {
        unbind "Ctrl b"
    }

    // Locked whitelist: navigate / float without unlocking (Ctrl-* still passes to nvim).
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt n" { NewPane; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
    }

    // Same Alt binds when unlocked (Normal / other modes except Locked).
    shared_except "locked" {
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt n" { NewPane; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
    }
}

plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm"
}
