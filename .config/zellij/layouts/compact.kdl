// Compact layout + zjstatus bottom bar (no powerline arrows).
// First-run permission prompt is often a 1-line sliver in this bar
// (zellij#4749). Focus the bar (click or Alt-j) and press `y`,
// or pre-write ~/.cache/zellij/permissions.kdl — see docs/zellij.md.

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                // false: hide_frame_for_single_pane=true causes resize flicker loop on Zellij 0.44.x
                hide_frame_for_single_pane "false"

                format_left   "{mode} #[fg=#7aa2f7,bold]{session} "
                format_center "{tabs}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                border_enabled "false"

                mode_normal        "#[bg=#9ece6a,fg=#16161e,bold] NORMAL "
                mode_locked        "#[bg=#f7768e,fg=#16161e,bold] LOCKED "
                mode_resize        "#[bg=#e0af68,fg=#16161e,bold] RESIZE "
                mode_pane          "#[bg=#bb9af7,fg=#16161e,bold] PANE "
                mode_tab           "#[bg=#7dcfff,fg=#16161e,bold] TAB "
                mode_scroll        "#[bg=#bb9af7,fg=#16161e,bold] SCROLL "
                mode_enter_search  "#[bg=#bb9af7,fg=#16161e,bold] SEARCH "
                mode_move          "#[bg=#73daca,fg=#16161e,bold] MOVE "
                mode_session       "#[bg=#ff9e64,fg=#16161e,bold] SESSION "
                mode_rename_tab    "#[bg=#7dcfff,fg=#16161e,bold] RENAME "
                mode_rename_pane   "#[bg=#bb9af7,fg=#16161e,bold] RENAME "
                mode_prompt        "#[bg=#ff9e64,fg=#16161e,bold] PROMPT "
                mode_tmux          "#[bg=#e0af68,fg=#16161e,bold] TMUX "

                tab_normal              "#[fg=#545c7e] {index}:{name} "
                tab_normal_fullscreen   "#[fg=#545c7e] {index}:{name}[] "
                tab_normal_sync         "#[fg=#545c7e] {index}:{name}* "
                tab_active              "#[fg=#c0caf5,bold] {index}:{name} "
                tab_active_fullscreen   "#[fg=#c0caf5,bold] {index}:{name}[] "
                tab_active_sync         "#[fg=#c0caf5,bold] {index}:{name}* "
                tab_separator           "#[fg=#3b4261]|"

                command_git_branch_command    "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format     "#[fg=#9ece6a] {stdout} "
                command_git_branch_interval   "10"
                command_git_branch_rendermode "static"

                datetime          "#[fg=#565f89] {format} "
                datetime_format   "%a %m-%d %H:%M"
                datetime_timezone "Asia/Shanghai"
            }
        }
    }
}
